<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ships with Windows 10/11, so players need nothing extra installed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PrometheusLauncher</AssemblyName>
    <RootNamespace>Prometheus.Launcher</RootNamespace>
    <ApplicationIcon>Assets\prometheus.ico</ApplicationIcon>
    <Product>Prometheus Launcher</Product>
    <Version>0.2.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <EmbeddedResource Include="Assets\flame-256.png" LogicalName="flame.png" />
  </ItemGroup>

</Project>
